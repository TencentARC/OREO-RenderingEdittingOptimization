# Keep Cursor from indexing heavy / generated / private local trees.
# Git already ignores most of these via .gitignore; this file makes the
# intent explicit for the IDE (do not un-ignore weights or reference code).

# Python / tooling caches
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Envs & secrets
.env
.env.*
.venv/
venv/
*.pem
*.key
credentials.json
secrets.json

# Editors
.idea/
.vscode/
.history/

# Training / logs / exports
logs/
logs*/
wandb/
outputs/
exports/
checkpoints/
profiler_logs/
experiments/
notebooks/
_chats/

# Large local assets
pretrained_weights/
_reference_codes/
data/
dataset/

# Weights / media / meshes
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.mp4
*.jpg
*.jpeg
*.png
*.glb
*.obj
*.ply
